# ─── Supabase (frontend) ────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ─── Secrets para las Edge Functions (configurar con: supabase secrets set) ──
# Google Calendar – Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
GOOGLE_CALENDAR_ID=tu-calendario@group.calendar.google.com   # o el email de la cuenta de Google

# Resend (envío de emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=citas@visionbi.co   # debe estar verificado en Resend
